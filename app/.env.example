# ─────────────────────────────────────────────────────────────
# Sonny — variables de entorno
# Copia este archivo a .env y rellena los valores.  NUNCA subas .env a git.
# Expo carga .env automáticamente (npx expo start / export).
# ─────────────────────────────────────────────────────────────

# ── Solo SERVIDOR (API route src/app/api/analyze+api.ts) ─────
# Nunca llegan al celular ni al navegador.

# Proveedor de la segunda opinión:
#   gemini  -> IA real (necesita AI_API_KEY)
#   mock    -> IA SIMULADA para probar sin clave ni internet (la app lo avisa: "Modo de prueba")
AI_PROVIDER=gemini

# Clave de la API de Gemini: https://aistudio.google.com/apikey
# Vacía = la app funciona solo con el modelo propio + reglas; las fotos se leen con el OCR del dispositivo.
AI_API_KEY=

# Modelo de Gemini (con visión, para leer fotos)
AI_MODEL=gemini-3.8-flash

# Tiempo máximo de espera de la IA, en milisegundos
AI_TIMEOUT_MS=14000

# Límite de análisis con IA por IP y por hora (protege el crédito)
RATE_LIMIT_PER_HOUR=20

# ── Solo con AI_PROVIDER=mock ────────────────────────────────
# auto (palabras clave) | scam | suspicious | safe | fail | slow | unreadable
AI_MOCK_SCENARIO=auto
# Espera simulada en milisegundos
AI_MOCK_DELAY_MS=600

# ── CLIENTE (EXPO_PUBLIC_*): se incluyen en la app, NO son secretos ──

# URL completa del servidor desplegado (EAS Hosting).
# Web: déjala vacía (usa la ruta relativa /api/analyze).
# APK: pon la URL del despliegue, por ejemplo https://sonny.expo.app
EXPO_PUBLIC_API_URL=
